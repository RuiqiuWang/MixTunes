{
  "name": "mixtunes-player",
  "version": "1.1.1",
  "description": "Local mixed-platform music playlist player for Windows and Linux",
  "private": true,
  "main": "src/main.cjs",
  "author": "MixTunes",
  "license": "MIT",
  "scripts": {
    "icons:generate": "node ../tools/generate-icons.cjs",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node --test test/locate-playing-ui.cjs",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable --x64",
    "prepare:electron": "node node_modules/electron/install.js",
    "predist": "npm run prepare:electron",
    "test:linux": "node --test test/linux-electron.cjs",
    "test:audio-network": "node --test test/audio-network-electron.cjs",
    "pack:omarchy": "node ../tools/build-omarchy.cjs",
    "install:omarchy": "node ../tools/install-omarchy.cjs",
    "start:omarchy": "/usr/lib/electron43/electron . --ozone-platform=wayland --enable-wayland-ime --wayland-text-input-version=3 --close-to-tray"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.58.2",
    "jsdom": "^26.1.0"
  },
  "build": {
    "appId": "local.mixlink.player",
    "productName": "MixTunes",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "ui/icons/app.ico",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "artifactName": "MixTunes-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "linux": {
      "executableName": "mixtunes",
      "icon": "ui/icons/app.png",
      "category": "AudioVideo",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "MixTunes",
          "Comment": "Play QQ Music, NetEase Cloud Music and Bilibili playlists",
          "Categories": "AudioVideo;Audio;Player;",
          "Keywords": "music;audio;playlist;"
        }
      }
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "desktopName": "mixtunes.desktop"
}
