{
  "name": "mixtunes-player",
  "version": "1.2.1",
  "description": "Local mixed-platform music playlist player for Windows",
  "private": true,
  "main": "src/main.cjs",
  "author": "MixTunes",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable --x64",
    "prepare:electron": "node node_modules/electron/install.js",
    "predist": "npm run prepare:electron"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "jsdom": "^26.1.0",
    "playwright-core": "1.58.2"
  },
  "build": {
    "appId": "local.mixlink.player",
    "productName": "MixTunes",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "icon": "ui/app-icon.ico",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "ui/app-icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "MixTunes-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "MixTunes-${version}-win-${arch}-便携版.${ext}"
    },
    "nsis": {
      "artifactName": "MixTunes-${version}-win-${arch}-安装版.${ext}",
      "include": "installer.nsh",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "MixTunes",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
